@prefix einzelplan: <http://example.org/digitalhaushalt/einzelplan/> .
@prefix funktion: <http://example.org/digitalhaushalt/funktion/> .
@prefix gruppe: <http://example.org/digitalhaushalt/gruppe/> .
@prefix kapitel: <http://example.org/digitalhaushalt/kapitel/> .
@prefix keyword: <http://example.org/digitalhaushalt/keyword/> .
@prefix klasse: <http://example.org/digitalhaushalt/digi-klasse/> .
