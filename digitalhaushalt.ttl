    schema:name "Innovation, Technologie und Neu[e Mobilität] {{{Digital}e} Agenda} {Mittelstand [{Digital}} ]Verpflichtungsermächtigu..."@de .

posten:90168622165_2023 a dh:Haushaltsposten ;
    dh:bereich bereich:digitalisierung-der-wirtschaft ;
    dh:digiKlasse klasse:1 ;
    dh:einzelplan einzelplan:9 ;
