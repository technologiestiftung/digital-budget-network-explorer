    dh:bereich bereich:digitalisierung-im-bereich-kultur-medien-zivilgesellschaft ;
    dh:digiKlasse klasse:3 ;
    dh:einzelplan einzelplan:6 ;
    dh:funktion funktion:187 ;
    dh:gruppe gruppe:685 ;
    dh:jahr "2025"^^xsd:gYear ;
