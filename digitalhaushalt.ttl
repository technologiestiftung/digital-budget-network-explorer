@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dh:Haushaltsposten a rdfs:Class,
        owl:Class ;
    rdfs:label "Haushaltsposten"@de ;
    rdfs:comment "Auspraegung eines Haushaltstitels in einem konkreten Haushaltsjahr mit Soll-/Ist-Betraegen und Klassifikation."@de ;
    rdfs:subClassOf schema:Intangible .

dh:Haushaltstitel a rdfs:Class,
        owl:Class ;
    rdfs:label "Haushaltstitel"@de ;
    rdfs:comment "Ein Haushaltstitel (identifiziert durch seine Titel-ID), der ueber mehrere Haushaltsjahre hinweg fortgeschrieben wird."@de ;
    rdfs:subClassOf schema:Intangible .

<http://example.org/digitalhaushalt/dataset> a schema:Dataset ;
    dcterms:title "Digitalhaushalt des Bundes"@de ;
    schema:description "Haushaltsposten des Bundes mit digitalem Ausgabenanteil, klassifiziert nach Bereichen und angereichert mit extrahierten Schlagwoertern."@de ;
    schema:name "Digitalhaushalt des Bundes"@de .

<http://example.org/digitalhaushalt/ontology> a owl:Ontology ;
    rdfs:label "Digitalhaushalt-Vokabular"@de ;
    rdfs:comment "Leichtgewichtiges Vokabular fuer den Digitalhaushalt-Datensatz. Erweitert schema.org, SKOS und Dublin Core Terms."@de .

dh:bereich a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Digitalisierungsbereich"@de ;
    rdfs:comment "Thematischer Digitalisierungsbereich."@de ;
    rdfs:domain dh:Haushaltsposten ;
    rdfs:range skos:Concept .

dh:cooccursWith a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "tritt gemeinsam auf mit"@de ;
    rdfs:comment "Verbindet zwei Keywords, die mindestens einmal im selben Haushaltsposten vorkommen. Bildet die Kanten des semantischen Keyword-Netzwerks."@de ;
    rdfs:subPropertyOf skos:related .

dh:digiKlasse a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Digitalisierungsklasse"@de ;
    rdfs:comment "Methodische Einstufung der Digitalisierung."@de ;
    rdfs:domain dh:Haushaltsposten ;
    rdfs:range skos:Concept .

dh:einzelplan a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Einzelplan"@de ;
    rdfs:comment "Zustaendiger Einzelplan (Ressort/Ministerium)."@de ;
    rdfs:domain dh:Haushaltsposten ;
    rdfs:range schema:GovernmentOrganization .

dh:funktion a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Funktion"@de ;
    rdfs:comment "Funktion (Funktionenplan) des Postens."@de ;
    rdfs:domain dh:Haushaltsposten ;
    rdfs:range skos:Concept .

dh:gruppe a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Gruppierung"@de ;
    rdfs:comment "Gruppierung (Gruppierungsplan) des Postens."@de ;
    rdfs:domain dh:Haushaltsposten ;
    rdfs:range skos:Concept .

dh:ist a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Ist-Betrag (tatsaechlich)"@de ;
    rdfs:comment "Ist-Betrag (tatsaechlich) – Angabe in Tausend Euro (1.000 €)."@de ;
    rdfs:range xsd:decimal .

dh:istDigitalEng a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Digitaler Anteil des Ist-Betrags (enge Abgrenzung)"@de ;
    rdfs:comment "Digitaler Anteil des Ist-Betrags (enge Abgrenzung) – Angabe in Tausend Euro (1.000 €)."@de ;
    rdfs:range xsd:decimal .

dh:istDigitalWeit a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Digitaler Anteil des Ist-Betrags (weite Abgrenzung)"@de ;
    rdfs:comment "Digitaler Anteil des Ist-Betrags (weite Abgrenzung) – Angabe in Tausend Euro (1.000 €)."@de ;
    rdfs:range xsd:decimal .

dh:jahr a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Haushaltsjahr"@de ;
    rdfs:range xsd:gYear .

dh:kapitel a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Kapitel"@de ;
    rdfs:comment "Haushaltskapitel des Postens."@de ;
    rdfs:domain dh:Haushaltsposten ;
    rdfs:range skos:Concept .

dh:soll a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Soll-Betrag (geplant)"@de ;
    rdfs:comment "Soll-Betrag (geplant) – Angabe in Tausend Euro (1.000 €)."@de ;
    rdfs:range xsd:decimal .

dh:sollDigitalEng a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Digitaler Anteil des Soll-Betrags (enge Abgrenzung)"@de ;
    rdfs:comment "Digitaler Anteil des Soll-Betrags (enge Abgrenzung) – Angabe in Tausend Euro (1.000 €)."@de ;
    rdfs:range xsd:decimal .

dh:sollDigitalWeit a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Digitaler Anteil des Soll-Betrags (weite Abgrenzung)"@de ;
    rdfs:comment "Digitaler Anteil des Soll-Betrags (weite Abgrenzung) – Angabe in Tausend Euro (1.000 €)."@de ;
    rdfs:range xsd:decimal .

